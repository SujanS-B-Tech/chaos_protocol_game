{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/join", "destination": "/public/mobile.html" },
    { "source": "/mobile.html", "destination": "/public/mobile.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/vendor/(.*)", "destination": "/public/vendor/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
